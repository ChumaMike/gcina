# Copy to .env.local. Never commit real values.
# Policy service base URL (L's service: http://localhost:8787 locally, Vercel URL in prod)
POLICY_URL=http://localhost:8787
# Operator bearer token for the policy service. Server-side only, never NEXT_PUBLIC_.
OPERATOR_TOKEN=
# Passcode the owner types to open the dashboard (httpOnly cookie session)
DASHBOARD_PASSCODE=
# Random string used to sign the session cookie
SESSION_SECRET=
# 1 = use the in-memory mock instead of the policy service
USE_MOCK=0
